[worldserver]

# mod-autonomous-altbots, Tofu fork (branch tofu).
# Requires:
#   EnablePlayerSettings = 1 in worldserver.conf
#   the Tofu fork of mod-playerbots (https://github.com/cdenq/wow-tofuworld-playerbots, branch tofu)
# Works with any value of Playerbots.DisabledWithoutRealPlayer: this module enforces its own rule that autonomous alts
# are online only while at least one real player is in the world.

# Enable persistent autonomous altbots.
AutonomousAltBots.Enable = 1

# Delay automatic logins after world startup so normal server initialization can settle.
AutonomousAltBots.StartupDelaySeconds = 30

# How often to check: log in enabled alts (only while a real player is in the world) and restore their strategies.
AutonomousAltBots.CheckIntervalSeconds = 10

# Log out every autonomous alt this many seconds after the last real player leaves the world.
AutonomousAltBots.NoPlayerLogoutDelaySeconds = 60

# Strategies while playing on its own. Characters keep their normal class, quest, loot, gear, and progression data.
AutonomousAltBots.Strategy.Quest = 1
AutonomousAltBots.Strategy.Grind = 1
AutonomousAltBots.Strategy.NewRpg = 1

# On level-up:
#   TeleportForLevel   - move to a zone that fits the new level (never to a city, so the hearthstone is not changed)
#   LearnTrainerSpells - learn class-trainer spells and pay the trainer cost (also once at each login);
#                        never profession recipes, riding, or weapon skills; spells it cannot afford wait for later
#   AutoTalents        - spend new talent points in the character's current tree (a character with no points
#                        spent yet gets a random tree, so spend the first point yourself)
AutonomousAltBots.LevelUp.TeleportForLevel = 1
AutonomousAltBots.LevelUp.LearnTrainerSpells = 1
AutonomousAltBots.LevelUp.AutoTalents = 1

# Ammo restocking for hunters: when ammo drops below AmmoThreshold and the character can afford ammo, it walks to the
# nearest friendly ammo vendor on the same map within VendorSearchDistance yards and buys with its own gold. Without
# gold it keeps grinding and tries again later. (Food and drink are covered by Playerbots.BotCheats "food".)
AutonomousAltBots.Restock.Enable = 1
AutonomousAltBots.Restock.AmmoThreshold = 200
AutonomousAltBots.Restock.VendorSearchDistance = 3000

# Challenge modes, read from the character's player settings under SettingSource (mod-challenge-modes). Indexes match
# mod-challenge-modes (-1 turns that check off). A challenge counts only below DisableLevel; the dead flag at any level.
#   Quest Only - the alt does not use the grind strategy (kill XP is 0 for it), so it spends its time on quests
#   Hardcore   - the alt cannot be turned on while Hardcore is active, unless AllowHardcore = 1
#   Dead flag  - a character that died on Hardcore is never logged in; an autonomous alt that dies on Hardcore is
#                turned off and logged out at once, even with AllowHardcore = 1
AutonomousAltBots.Challenge.SettingSource = "mod-challenge-modes"
AutonomousAltBots.Challenge.HardcoreIndex = 0
AutonomousAltBots.Challenge.HardcoreDeadIndex = 8
AutonomousAltBots.Challenge.QuestOnlyIndex = 6
AutonomousAltBots.Challenge.DisableLevel = 80
AutonomousAltBots.Challenge.AllowHardcore = 0

# Hardcore survival, for Hardcore alts that may play (AllowHardcore = 1). It applies while a real player leads the alt
# too. Requires the Tofu fork of mod-playerbots at the matching commit.
#   RestHealthPct  - out of combat, below this health the alt eats and starts no new fight
#   FleeHealthPct  - in combat, below this health the alt runs from its attackers until the fight ends or it recovers
#   MaxLevelsAbove - it picks no target more than this many levels above itself (stock playerbots: 4)
# Hardcore alts also never teleport on level-up, never go to outdoor PvP objectives, and do not attack enemy players.
AutonomousAltBots.Hardcore.RestHealthPct = 80
AutonomousAltBots.Hardcore.FleeHealthPct = 30
AutonomousAltBots.Hardcore.MaxLevelsAbove = 2

# Challenge grouping side for parties: a party is all characters with any of these mod-challenge-modes indexes active
# (below DisableLevel), or none. Default: Hardcore, Self Crafted, Green Quality, Quest Only, and One Rate (not
# Progression, which mod-challenge-modes lets group with anyone). Must match mod-challenge-modes' grouping rule.
AutonomousAltBots.Challenge.RestrictingIndexes = "0,2,3,6,9"

# Parties (.autoalt party ...), stored in acore_characters.tofu_autoalt_party and tofu_autoalt_party_member. Requires
# the Tofu fork of mod-playerbots at the matching commit.
#   Enable          - 1 groups party members that are playing; 0 leaves every alt solo and turns the commands off
#   EliteMinMembers - an elite quest is done only with at least this many members present
#   PresentRange    - a member counts as present within this many yards of the leader (same map)
#   RegroupDistance - a follower on the leader's map farther than this many yards teleports to it (another map always)
AutonomousAltBots.Party.Enable = 0
AutonomousAltBots.Party.EliteMinMembers = 3
AutonomousAltBots.Party.PresentRange = 100
AutonomousAltBots.Party.RegroupDistance = 300

# Extra detail in the worldserver log.
AutonomousAltBots.VerboseLogging = 0
